{
  "manifest_version": 3,
  "name": "Robot Orchestra \u2014 Browser Companion",
  "version": "0.3.0",
  "description": "Right-click to explicitly scan a bounded number of pages on the current site and chat with Hermes.",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "sidePanel", "contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Open Robot Orchestra"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "key": ""
}
