    MAIN --> ROUTER
    ROUTER -->|"direct · no agents"| OLLAMA
    ROUTER -->|"delegated task"| HERMES
    HOST -->|"loopback bridge"| MAIN
  end

  subgraph BROWSER["Chrome / Edge · user-triggered"]
    TAB["Active tab / same-origin site"]
    EXT["Robot Orchestra side panel"]
    PREVIEW["Scan preview<br/>user selects whether to attach"]
    TAB -->|"explicit share or bounded scan"| EXT
    EXT --> PREVIEW
  end

  subgraph PROVIDERS["Provider / optional services"]
    OPENROUTER["OpenRouter<br/>selected zero-price model · availability varies"]
    AGENTS["Hermes-configured specialists<br/>Scout · Builder · Reviewer"]
    HF["Optional Hugging Face<br/>Realtime speech server"]
  end

  USER --> UI
  EXT -->|"Native Messaging"| HOST
  PREVIEW -->|"only after explicit send"| ROUTER
  HERMES --> OPENROUTER
  HERMES --> AGENTS
  MIC["Microphone<br/>enabled only after Talk"] --> HF
  HF -->|"recognized task"| ROUTER

