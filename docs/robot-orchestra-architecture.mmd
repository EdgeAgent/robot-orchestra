flowchart TB
  USER([You])

  subgraph LOCAL["Windows desktop · local-first app"]
    UI["React dashboard + floating robot copilot"]
    MAIN["Electron main process<br/>loopback API · safe IPC · tray · hotkey"]
    HOST[".NET Native Messaging host"]
    BRAIN[("Brain state<br/>goals · ideas · activity · artifacts")]
    KNOW[("Local Knowledge index<br/>extracted document text")]
    ROUTER{"Selected-model router"}
    OLLAMA["Ollama<br/>127.0.0.1:11434 · direct local"]
    HERMES["User-configured Hermes adapter<br/>loopback only"]
    UI <-->|"context-isolated IPC / local API"| MAIN
    MAIN --> BRAIN
